{
  "name": "nervus",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript semantic kernel for building pluggable AI agents, powered by Cordis.",
  "type": "module",
  "bin": {
    "nervus": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:openai": "node --env-file=.env --import tsx examples/openai-compatible.ts",
    "smoke:deepseek:tools": "node --env-file=.env --import tsx examples/deepseek-tool-agent.ts",
    "nervus:dev": "node --env-file=.env --import tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "ajv": "8.20.0",
    "cordis": "4.0.0-rc.9"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  }
}
