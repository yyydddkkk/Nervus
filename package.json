{
  "name": "nervus",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript semantic kernel for building pluggable AI agents, powered by Cordis.",
  "type": "module",
  "bin": {
    "nervus": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:capability-library && pnpm build:profile && pnpm build:core && pnpm build:host && pnpm build:kernel && pnpm build:coding-host",
    "build:capability-library": "pnpm --dir packages/capability-library build",
    "build:profile": "pnpm --dir packages/profile build",
    "build:core": "tsc -p tsconfig.core.build.json",
    "build:host": "pnpm --dir packages/host build",
    "build:kernel": "tsc -p tsconfig.build.json",
    "build:coding-host": "pnpm --dir apps/coding-agent build",
    "typecheck": "tsc -p tsconfig.json && pnpm --dir packages/capability-library typecheck && pnpm --dir packages/profile typecheck && pnpm --dir packages/host typecheck && pnpm --dir apps/coding-agent typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:openai": "node --env-file=.env --import tsx examples/openai-compatible.ts",
    "smoke:deepseek:tools": "node --env-file=.env --import tsx examples/deepseek-tool-agent.ts",
    "smoke:deepseek:coding": "pnpm build:kernel && node --env-file=.env --import tsx examples/deepseek-coding-host.ts",
    "smoke:deepseek:stabilization": "pnpm build && node --env-file=.env --import tsx examples/deepseek-coding-stabilization.ts",
    "smoke:deepseek:assembly": "pnpm build && node --env-file=.env --import tsx examples/deepseek-profile-host-assembly.ts",
    "nervus:dev": "node --env-file=.env --import tsx src/cli.ts",
    "nervus-code:dev": "pnpm build:kernel && node --env-file=.env --import tsx apps/coding-agent/src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@nervus/capability-library": "workspace:*",
    "@nervus/host": "workspace:*",
    "@nervus/profile": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "ajv": "8.20.0",
    "cordis": "4.0.0-rc.9"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  }
}
